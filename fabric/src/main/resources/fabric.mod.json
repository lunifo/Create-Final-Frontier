{
  "schemaVersion": 1,
  "id": "finalfrontier",
  "version": "${version}",
  "name": "Create: Final Frontier",
  "description": "A Minecraft Create mod addon focusing on semi-realistic space travel",
  "authors": [
    "Me!"
  ],
  "contact": {
    "issues": "https://github.com/lunifo/Create-Final-Frontier/issues",
    "sources": "https://github.com/lunifo/Create-Final-Frontier"
  },
  "license": "MIT",
  "icon": "assets/finalfrontier/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.lunifo.finalfrontier.fabric.FinalFrontierFabric"
    ],
    "client": [
      "io.github.lunifo.finalfrontier.fabric.FinalFrontierClientFabric"
    ],
    "fabric-datagen": [
      "io.github.lunifo.finalfrontier.fabric.FinalFrontierDataGeneration"
    ]
  },
  "mixins": [
    "finalfrontier.mixins.json",
    "finalfrontier-common.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": "${create_version}"
  }
}